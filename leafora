<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leafora - AI Plant Doctor</title>
    <script src="https://unpkg.com/@google/generative-ai"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-dark: #0a1f0d;
            --green-primary: #22c55e;
            --green-dark: #166534;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0a1f0d 0%, #1a3a2a 50%, #0d2818 100%);
            min-height: 100vh;
            color: white;
            overflow-x: hidden;
        }

        /* Leaf Pattern Background */
        .leaf-pattern {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
        }

        .leaf {
            position: absolute;
            opacity: 0.15;
        }

        .leaf-1 {
            top: -50px;
            left: -50px;
            width: 300px;
            animation: float 6s ease-in-out infinite;
        }

        .leaf-2 {
            top: 200px;
            right: -30px;
            width: 200px;
            animation: float 8s ease-in-out infinite;
            animation-delay: 2s;
        }

        .leaf-3 {
            bottom: 100px;
            left: 50px;
            width: 150px;
            animation: float 7s ease-in-out infinite;
            animation-delay: 1s;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-20px) rotate(5deg);
            }
        }

        /* Header */
        .header {
            position: relative;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
        }

        .menu-btn,
        .cart-btn {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
            color: white;
        }

        .menu-btn:hover,
        .cart-btn:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .logo {
            font-size: 1.4rem;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .cart-wrapper {
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--green-primary);
            color: white;
            font-size: 0.7rem;
            font-weight: bold;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Main Content */
        .main {
            position: relative;
            z-index: 10;
            padding: 0 24px 120px;
        }

        .welcome {
            margin-bottom: 24px;
        }

        .welcome h2 {
            font-size: 1.8rem;
            margin-bottom: 4px;
        }

        .welcome p {
            color: #9ca3af;
            font-size: 0.9rem;
        }

        /* Cards */
        .diagnose-card {
            background: linear-gradient(135deg, #166534 0%, #14532d 100%);
            border-radius: 24px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 0 40px rgba(34, 197, 94, 0.2);
        }

        .diagnose-card h3 {
            font-size: 1.6rem;
            margin-bottom: 12px;
            line-height: 1.3;
        }

        .diagnose-card .highlight {
            background: linear-gradient(135deg, #4ade80, #22c55e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .diagnose-card p {
            color: #d1d5db;
            font-size: 0.85rem;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .btn-group {
            display: flex;
            gap: 12px;
        }

        .btn-primary {
            background: white;
            color: #111;
            border: none;
            padding: 12px 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }

        .btn-primary:hover {
            background: #f3f4f6;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 12px 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* Glass Card */
        .glass-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
        }

        /* Stats */
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }

        .stat-card {
            padding: 16px;
            text-align: center;
        }

        .stat-card .icon {
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

        .stat-card .value {
            font-size: 1.5rem;
            font-weight: bold;
        }

        .stat-card .label {
            font-size: 0.7rem;
            color: #9ca3af;
        }

        /* History Section */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .section-header h3 {
            font-size: 1.1rem;
        }

        .section-header a {
            color: var(--green-primary);
            font-size: 0.85rem;
            text-decoration: none;
        }

        .history-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            margin-bottom: 12px;
        }

        .history-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .history-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(34, 197, 94, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .history-name {
            font-weight: 600;
            margin-bottom: 4px;
        }

        .history-detail {
            font-size: 0.75rem;
            color: #9ca3af;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .status-recovering {
            background: rgba(34, 197, 94, 0.2);
            color: #4ade80;
        }

        .status-healthy {
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
        }

        /* Bottom Navigation */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(20, 40, 30, 0.95);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 100;
        }

        .nav-items {
            display: flex;
            justify-content: space-around;
            padding: 12px 16px;
            max-width: 500px;
            margin: 0 auto;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 8px 16px;
            border-radius: 12px;
            text-decoration: none;
            color: #6b7280;
            transition: all 0.3s;
            font-size: 0.7rem;
        }

        .nav-item.active {
            color: #4ade80;
            background: rgba(34, 197, 94, 0.2);
        }

        .nav-item:hover {
            color: #d1d5db;
        }

        .nav-icon {
            font-size: 1.3rem;
            margin-bottom: 4px;
        }

        /* Page Transitions */
        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        /* Diagnose Page */
        .back-btn {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: white;
            font-size: 1.2rem;
        }

        .page-title {
            font-size: 1.2rem;
            font-weight: bold;
        }

        .upload-area {
            border: 2px dashed rgba(34, 197, 94, 0.4);
            border-radius: 24px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 24px;
        }

        .upload-area:hover {
            border-color: #22c55e;
            background: rgba(34, 197, 94, 0.1);
        }

        .upload-area.dragover {
            border-color: #4ade80;
            background: rgba(34, 197, 94, 0.2);
        }

        .upload-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(34, 197, 94, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 1.8rem;
        }

        .upload-area h3 {
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .upload-area p {
            color: #6b7280;
            font-size: 0.85rem;
            margin-bottom: 16px;
        }

        .upload-meta {
            display: flex;
            justify-content: center;
            gap: 16px;
            font-size: 0.75rem;
            color: #4b5563;
        }

        /* Image Preview */
        .image-preview {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .image-preview img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .remove-btn {
            position: absolute;
            top: 16px;
            right: 16px;
            background: rgba(0, 0, 0, 0.5);
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: white;
        }

        /* Analyze Button */
        .analyze-btn {
            width: 100%;
            padding: 16px;
            border-radius: 16px;
            border: none;
            background: linear-gradient(135deg, #22c55e, #059669);
            color: white;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s;
        }

        .analyze-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(34, 197, 94, 0.3);
        }

        .analyze-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* Results */
        .results {
            margin-top: 24px;
        }

        .result-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
        }

        .result-header h3 {
            font-size: 1.3rem;
        }

        .severity-badge {
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .severity-low {
            background: rgba(34, 197, 94, 0.2);
            color: #4ade80;
        }

        .severity-medium {
            background: rgba(234, 179, 8, 0.2);
            color: #facc15;
        }

        .severity-high {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
        }

        .result-diagnosis {
            color: #d1d5db;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* Expandable Sections */
        .expandable {
            margin-top: 16px;
            border-radius: 20px;
            overflow: hidden;
        }

        .expandable-header {
            width: 100%;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: transparent;
            border: none;
            color: white;
            cursor: pointer;
        }

        .expandable-header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .expandable-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .expandable-content {
            padding: 0 20px 20px;
            display: none;
        }

        .expandable-content.open {
            display: block;
        }

        .disease-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
        }

        .disease-card h4 {
            margin-bottom: 8px;
        }

        .disease-card p {
            color: #9ca3af;
            font-size: 0.85rem;
            margin-bottom: 16px;
        }

        .list-title {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .list-title.prevention {
            color: #4ade80;
        }

        .list-title.treatment {
            color: #60a5fa;
        }

        .checklist {
            list-style: none;
        }

        .checklist li {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 6px;
            font-size: 0.85rem;
            color: #d1d5db;
        }

        .check-icon {
            color: #4ade80;
            margin-top: 2px;
        }

        .check-icon.blue {
            color: #60a5fa;
        }

        /* Care Grid */
        .care-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .care-item {
            padding: 16px;
            border-radius: 16px;
        }

        .care-item .care-icon {
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

        .care-item h5 {
            font-size: 0.85rem;
            margin-bottom: 4px;
        }

        .care-item p {
            font-size: 0.75rem;
            color: #9ca3af;
            line-height: 1.4;
        }

        .care-water {
            background: rgba(59, 130, 246, 0.1);
        }

        .care-sun {
            background: rgba(234, 179, 8, 0.1);
        }

        .care-humidity {
            background: rgba(168, 85, 247, 0.1);
        }

        .care-temp {
            background: rgba(249, 115, 22, 0.1);
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }

        .action-buttons button {
            flex: 1;
            padding: 14px;
            border-radius: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-reset {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-reset:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .btn-save {
            background: #22c55e;
            color: white;
            border: none;
        }

        .btn-save:hover {
            background: #16a34a;
        }

        /* Loading Spinner */
        .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Page Header */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
        }

        .page-header-spacer {
            width: 40px;
        }

        /* Intro Section */
        .intro {
            text-align: center;
            margin-bottom: 32px;
        }

        .intro-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(34, 197, 94, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 2.5rem;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                box-shadow: 0 0 20px rgba(34, 197, 94, 0.3);
            }

            50% {
                box-shadow: 0 0 40px rgba(34, 197, 94, 0.6);
            }
        }

        .intro h2 {
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

        .intro p {
            color: #9ca3af;
            font-size: 0.9rem;
            max-width: 300px;
            margin: 0 auto;
            line-height: 1.5;
        }

        /* Plants Page */
        .search-box {
            padding: 16px;
            margin-bottom: 24px;
        }

        .search-box input {
            background: transparent;
            border: none;
            color: white;
            width: 100%;
            font-size: 1rem;
            outline: none;
        }

        .search-box input::placeholder {
            color: #4b5563;
        }

        .plants-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .plant-card {
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: transform 0.3s;
        }

        .plant-card:hover {
            transform: translateY(-4px);
        }

        .plant-card .plant-icon {
            font-size: 3rem;
            margin-bottom: 12px;
        }

        .plant-card h4 {
            font-size: 0.95rem;
            margin-bottom: 8px;
        }

        /* History Page */
        .history-page-item {
            padding: 20px;
            margin-bottom: 16px;
        }

        .history-page-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .history-page-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: rgba(34, 197, 94, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }

        .history-page-name {
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 4px;
        }

        .history-page-issue {
            color: #9ca3af;
            font-size: 0.85rem;
        }

        .history-page-date {
            color: #6b7280;
            font-size: 0.75rem;
            margin-top: 4px;
        }

        .status-treated {
            background: rgba(234, 179, 8, 0.2);
            color: #facc15;
        }

        /* API Key Modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 24px;
        }

        .modal-overlay.hidden {
            display: none;
        }

        .modal {
            background: #1a3a2a;
            border-radius: 24px;
            padding: 32px;
            max-width: 400px;
            width: 100%;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .modal h2 {
            font-size: 1.4rem;
            margin-bottom: 8px;
        }

        .modal p {
            color: #9ca3af;
            font-size: 0.85rem;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .modal input {
            width: 100%;
            padding: 14px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.1);
            color: white;
            font-size: 0.9rem;
            margin-bottom: 16px;
            outline: none;
        }

        .modal input:focus {
            border-color: #22c55e;
        }

        .modal-btn {
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #22c55e, #059669);
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .modal-btn:hover {
            transform: translateY(-2px);
        }

        /* Responsive */
        @media (min-width: 768px) {
            .main {
                max-width: 500px;
                margin: 0 auto;
            }

            .bottom-nav {
                max-width: 500px;
                left: 50%;
                transform: translateX(-50%);
                border-radius: 24px 24px 0 0;
            }
        }
    </style>
</head>

<body>
    <!-- Leaf Pattern Background -->
    <div class="leaf-pattern">
        <svg class="leaf leaf-1" viewBox="0 0 100 100" fill="none">
            <path d="M50 10 C20 30, 10 60, 50 90 C90 60, 80 30, 50 10Z" fill="#22c55e" />
            <path d="M50 20 L50 80" stroke="#15803d" stroke-width="1" />
            <path d="M50 40 C40 35, 30 40, 25 45" stroke="#15803d" stroke-width="0.5" fill="none" />
            <path d="M50 50 C60 45, 70 50, 75 55" stroke="#15803d" stroke-width="0.5" fill="none" />
        </svg>
        <svg class="leaf leaf-2" viewBox="0 0 100 100" fill="none">
            <path d="M30 50 C50 20, 80 30, 90 50 C80 80, 50 90, 30 50Z" fill="#16a34a" />
        </svg>
        <svg class="leaf leaf-3" viewBox="0 0 100 100" fill="none">
            <path d="M50 20 C25 40, 30 70, 50 80 C70 70, 75 40, 50 20Z" fill="#22c55e" />
        </svg>
    </div>

    <!-- API Key Modal -->
    <div class="modal-overlay" id="apiKeyModal">
        <div class="modal">
            <h2>🌿 Welcome to Leafora</h2>
            <p>Enter your Google Gemini API key to start diagnosing your plants. Get a free key at <a
                    href="https://aistudio.google.com/" target="_blank" style="color: #4ade80;">aistudio.google.com</a>
            </p>
            <input type="password" id="apiKeyInput" placeholder="Paste your Gemini API key here...">
            <button class="modal-btn" onclick="saveApiKey()">Start Diagnosing</button>
        </div>
    </div>

    <!-- HOME PAGE -->
    <div class="page active" id="homePage">
        <header class="header">
            <button class="menu-btn">☰</button>
            <span class="logo">Leafora</span>
            <div class="cart-wrapper">
                <button class="cart-btn">🛒</button>
                <span class="cart-badge">2</span>
            </div>
        </header>

        <main class="main">
            <div class="welcome">
